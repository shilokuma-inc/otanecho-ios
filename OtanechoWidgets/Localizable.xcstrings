    "Glance at your latest seeds, and plant a new one with a tap." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直近の種を眺めつつ、1 タップで新しい種をまきます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wirf einen Blick auf deine letzten Samen und pflanze mit einem Tippen einen neuen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Echa un vistazo a tus últimas semillas y planta una nueva con un toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetez un œil à vos dernières graines et plantez-en une nouvelle d’un geste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lihat benih terbarumu, lalu tanam yang baru dengan sekali ketuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dai uno sguardo ai semi più recenti e piantane uno nuovo con un tocco."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "최근 씨앗을 살펴보고, 한 번의 탭으로 새 씨앗을 심습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dê uma olhada nas suas sementes recentes e plante uma nova com um toque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Посмотрите на последние семена и посадите новое одним касанием."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一眼看到最近的种子，轻点一下就能播下新的。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一眼看到最近的種子，輕點一下就能播下新的。"
          }
        }
      }
    },
    "Jot down an idea from the Lock Screen with a single tap." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ロック画面から 1 タップでアイデアを書き留めます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte eine Idee mit einem Tippen direkt vom Sperrbildschirm fest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apunta una idea desde la pantalla bloqueada con un solo toque."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notez une idée depuis l’écran verrouillé d’un seul geste."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Catat ide dari Layar Terkunci dengan sekali ketuk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Annota un’idea dalla schermata di blocco con un solo tocco."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "잠금 화면에서 한 번의 탭으로 아이디어를 적습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anote uma ideia na Tela Bloqueada com um único toque."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запишите идею с заблокированного экрана одним касанием."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在锁定屏幕上轻点一下就能记下想法。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在鎖定畫面輕點一下就能記下想法。"
          }
        }
      }
