    "Allow microphone and speech recognition in Settings to write by speaking." : {
      "localizations" : {
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "設定アプリでマイクと音声認識を許可すると、話して書き留められます。"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlaube Mikrofon und Spracherkennung in den Einstellungen, um beim Sprechen mitzuschreiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite el micrófono y el reconocimiento de voz en Ajustes para escribir hablando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autorisez le micro et la reconnaissance vocale dans Réglages pour écrire en parlant."
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Izinkan mikrofon dan pengenalan suara di Pengaturan agar bisa menulis dengan berbicara."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consenti microfono e riconoscimento vocale in Impostazioni per scrivere parlando."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정에서 마이크와 음성 인식을 허용하면 말로 적을 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permita o microfone e o reconhecimento de fala nos Ajustes para escrever falando."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разрешите микрофон и распознавание речи в Настройках, чтобы записывать голосом."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在“设置”中允许使用麦克风和语音识别，就能用说话的方式记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在「設定」中允許使用麥克風與語音辨識，就能用說話的方式記錄。"
          }
        }
      }
    },
